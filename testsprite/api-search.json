      "description": "Search for 'invoice' returns relevant results"
    },
    {
      "type": "assertion",
      "action": "assert_response_body_contains",
      "expected": "Invoice",
      "description": "Response contains Invoice results"
    },
    {
      "type": "action",
      "action": "http_request",
      "method": "GET",
      "url": "https://clientgateway.vercel.app/api/search?q=payment",
      "expected_status": 200,
      "description": "Search for 'payment' returns relevant results"
    },
    {
      "type": "assertion",
      "action": "assert_response_body_contains",
      "expected": "Payment",
      "description": "Response contains Payment results"
    },
    {
      "type": "action",
      "action": "http_request",
      "method": "GET",
      "url": "https://clientgateway.vercel.app/api/search?q=",
